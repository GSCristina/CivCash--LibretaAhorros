<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #e8eeee;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.libretaahorros.libretaahorros.controlador.MovimientoController">
    <children>
        <Label text="Gestión de Movimiento">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
        </Label>
        <GridPane hgap="10.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Concepto:" />
                <Label text="Cantidad (€):" GridPane.rowIndex="1" />
                <Label text="Fecha:" GridPane.rowIndex="2" />
                <Label text="Tipo:" GridPane.rowIndex="3" />
                <TextField fx:id="txtConcepto" GridPane.columnIndex="1" />
                <TextField fx:id="txtCantidad" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <DatePicker fx:id="dpFecha" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <ComboBox fx:id="cbTipo" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Categoria:" GridPane.rowIndex="4" />
            <ComboBox fx:id="cbCategoria" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Label text="Responsable" GridPane.rowIndex="5" />
            <TextField fx:id="txtResponsable" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#accionCancelar" text="Cancelar">
               <effect>
                  <DropShadow height="4.62" radius="1.225" width="2.28">
                     <color>
                        <Color red="0.6000000238418579" green="0.6000000238418579" blue="0.6000000238418579" />
                     </color>
                  </DropShadow>
               </effect></Button>
                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#accionGuardar" style="-fx-background-color: #2ecc71;" text="Guardar" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
               <effect>
                  <DropShadow height="4.62" radius="2.9800000000000004" width="9.3">
                     <color>
                        <Color red="0.5894736647605896" green="0.5894736647605896" blue="0.5894736647605896" />
                     </color>
                  </DropShadow>
               </effect></Button>
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
