<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.libretaahorros.libretaahorros.controlador.SelectorLibretasController">
    <children>

        <Label text="Mis Libretas">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
        </Label>

        <Label fx:id="lblUsuario" text="Bienvenido, usuario@email.com" textFill="#666666" />

        <ScrollPane fitToWidth="true" prefHeight="250.0" style="-fx-background-color: transparent;">
            <content>
                <FlowPane fx:id="fpLibretas" hgap="15.0" vgap="15.0">
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </FlowPane>
            </content>
        </ScrollPane>
        
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button onAction="#handleNuevaLibreta" style="-fx-background-color: #2ecc71;" text="+ Nueva Libreta" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
               <HBox.margin>
                  <Insets bottom="10.0" />
               </HBox.margin>
                </Button>
                <Button onAction="#handleCerrarSesion" style="-fx-background-color: #e74c3c;" text="Cerrar Sesión" textFill="WHITE">
               <HBox.margin>
                  <Insets bottom="10.0" />
               </HBox.margin></Button>
            </children>
        </HBox>
    </children>
</VBox>
